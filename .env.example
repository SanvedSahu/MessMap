# MessMap Full-Stack Environment Template
# Copy this file to .env for Docker Compose and local multi-service orchestration.

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=messmap_dev_db
MYSQL_USER=messmap_user
MYSQL_PASSWORD=messmap_secret_password
MYSQL_ROOT_PASSWORD=messmap_root_password

# ------------------------------------------------------------------------------
# Backend Spring Boot Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:3001
SHOW_SQL=false
JWT_SECRET=replace_with_a_secure_random_secret_for_local_development
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# Frontend Vite Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
VITE_USE_MOCK=true
