# MessMap Full-Stack Environment Template
# Copy this file to .env for Docker Compose and local multi-service orchestration.

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=messmap_db
MYSQL_USER=messmap_user
MYSQL_PASSWORD=messmap_secret_password
MYSQL_ROOT_PASSWORD=messmap_root_password

# ------------------------------------------------------------------------------
# Backend Spring Boot Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# Frontend Vite Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
VITE_USE_MOCK=true
